{
  "policy": {
    "mode": "open_ended",
    "purpose": "discover employers and official career sites; never an eligibility allowlist",
    "official_career_site_primary": true
  },
  "feeders": [
    {
      "id": "sec_public_companies",
      "enabled": true,
      "kind": "authoritative_identity",
      "scope": "US public registrants"
    },
    {
      "id": "existing_source_companies",
      "enabled": true,
      "kind": "internal_seed",
      "scope": "companies already configured or learned"
    },
    {
      "id": "discovered_job_employers",
      "enabled": true,
      "kind": "continuous_learning",
      "scope": "employers encountered by any job discovery source"
    },
    {
      "id": "ncua_active_credit_unions",
      "enabled": true,
      "kind": "authoritative_identity",
      "scope": "active federally insured U.S. credit unions"
    },
    {
      "id": "fdic_insured_banks",
      "enabled": true,
      "kind": "authoritative_identity_with_official_url",
      "scope": "active FDIC-insured U.S. institutions"
    },
    {
      "id": "college_scorecard_institutions",
      "enabled": true,
      "kind": "authoritative_identity_with_official_url",
      "scope": "operating U.S. colleges and universities; API key required"
    },
    {
      "id": "cms_hospitals",
      "enabled": true,
      "kind": "authoritative_identity",
      "scope": "U.S. hospital organizations from CMS Provider Data Catalog"
    },
    {
      "id": "sam_registered_entities",
      "enabled": true,
      "kind": "authoritative_identity",
      "scope": "active SAM.gov registered organizations; API key required"
    }
  ],
  "expansion_classes": [
    {
      "id": "private_companies",
      "status": "planned"
    },
    {
      "id": "startups",
      "status": "planned"
    },
    {
      "id": "healthcare",
      "status": "implemented"
    },
    {
      "id": "universities",
      "status": "implemented"
    },
    {
      "id": "financial_services",
      "status": "implemented"
    },
    {
      "id": "consulting_staffing",
      "status": "planned"
    },
    {
      "id": "retail_logistics_manufacturing",
      "status": "planned"
    },
    {
      "id": "government_public_sector",
      "status": "planned"
    },
    {
      "id": "nonprofits",
      "status": "planned"
    }
  ],
  "authoritative_catalogs": [
    {
      "id": "sec",
      "status": "working",
      "scope": "public registrants and market participants"
    },
    {
      "id": "ncua_active_credit_unions",
      "status": "implemented",
      "scope": "active federally insured U.S. credit unions"
    },
    {
      "id": "ncua_cuso_registry",
      "status": "next",
      "scope": "credit union service organizations; registry can include public website"
    },
    {
      "id": "fdic_bank_directory",
      "status": "implemented",
      "scope": "insured banks and institutions"
    },
    {
      "id": "education_institutions",
      "status": "implemented",
      "scope": "universities and colleges"
    },
    {
      "id": "healthcare_provider_orgs",
      "status": "implemented",
      "scope": "health systems and provider organizations"
    }
  ],
  "next_implementation_priority": [
    "private_companies",
    "startups",
    "consulting_staffing",
    "retail_logistics_manufacturing",
    "government_public_sector",
    "nonprofits"
  ],
  "validation_policy": {
    "career_source_required": true,
    "executable_ats_required_for_working": true,
    "metrics": [
      "employers_loaded",
      "official_domains_resolved",
      "career_pages_resolved",
      "ats_sources_learned",
      "custom_career_sites",
      "resolution_failures"
    ],
    "rule": "A feeder/category is not WORKING merely because employer identities were loaded; official career-page resolution and executable job-source promotion must be measured."
  }
}
